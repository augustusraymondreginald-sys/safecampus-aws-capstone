# # Copy this file to .env and fill in real values.
# # NEVER commit the actual .env file — add it to .gitignore.

# # --- Server ---
# PORT=4000

# # --- RDS (MySQL) ---
# DB_HOST=your-rds-endpoint.rds.amazonaws.com
# DB_PORT=3306
# DB_USER=admin
# DB_PASSWORD=your-db-password
# DB_NAME=safecampus

# # --- Auth ---
# # Generate a long random string, e.g.: openssl rand -hex 32
# JWT_SECRET=replace-with-a-long-random-secret
# JWT_EXPIRES_IN=8h

# # --- S3 ---
# AWS_REGION=us-east-1
# S3_BUCKET_NAME=safecampus-evidence-bucket
# # Do NOT put AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY here in production.
# # On EC2, attach an IAM Role with S3 permissions instead — the SDK picks it up
# # automatically. Only use static keys for local testing, and never commit them.


DB_HOST=localhost
DB_PORT=5432
DB_USER=your_pg_user
DB_PASSWORD=your_pg_password
DB_NAME=safecampus
JWT_SECRET=your_secret_key
JWT_EXPIRES_IN=8h
PORT=4000